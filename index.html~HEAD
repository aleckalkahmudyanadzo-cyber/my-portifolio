<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // ------------------------------
    // 1. PERMANENT PROFILE PICTURE (localStorage)
    // ------------------------------
    const profileImg = document.getElementById('profileImg');
    const uploadInput = document.getElementById('photoUploadInput');
    const uploadBtn = document.getElementById('uploadPhotoBtn');
    const resetBtn = document.getElementById('resetPhotoBtn');
    const DEFAULT_AVATAR = "https://ui-avatars.com/api/?background=F5B042&color=fff&rounded=true&size=180&bold=true&name=AM";

    // load saved picture if exists
    const savedPicture = localStorage.getItem('permanentProfilePic');
    if (savedPicture && savedPicture !== 'undefined') {
        profileImg.src = savedPicture;
    } else {
        profileImg.src = DEFAULT_AVATAR;
    }

    uploadBtn.addEventListener('click', () => uploadInput.click());
    uploadInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = (ev) => {
                const imgData = ev.target.result;
                profileImg.src = imgData;
                localStorage.setItem('permanentProfilePic', imgData);
                // optional small feedback
                const toastMsg = document.createElement('div');
                toastMsg.className = 'alert alert-success small position-fixed bottom-0 end-0 m-3';
                toastMsg.innerHTML = '✅ Profile picture saved permanently!';
                document.body.appendChild(toastMsg);
                setTimeout(() => toastMsg.remove(), 2000);
            };
            reader.readAsDataURL(file);
        } else {
            alert('Please select a valid image (PNG, JPG)');
        }
    });

    resetBtn.addEventListener('click', () => {
        profileImg.src = DEFAULT_AVATAR;
        localStorage.removeItem('permanentProfilePic');
        alert('Default profile picture restored.');
    });

    // ------------------------------
    // 2. DARK MODE with system preference + localStorage
    // ------------------------------
    const darkModeToggle = document.getElementById('darkModeToggle');
    const themeSpan = document.getElementById('themeText');
    const setDarkMode = (isDark) => {
        if (isDark) {
            document.body.classList.add('dark-mode');
            localStorage.setItem('portfolioDarkMode', 'true');
            themeSpan.innerHTML = 'Light';
            darkModeToggle.innerHTML = '<i class="fas fa-sun"></i> Light';
        } else {
            document.body.classList.remove('dark-mode');
            localStorage.setItem('portfolioDarkMode', 'false');
            themeSpan.innerHTML = 'Dark';
            darkModeToggle.innerHTML = '<i class="fas fa-moon"></i> Dark';
        }
    };
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const savedDark = localStorage.getItem('portfolioDarkMode');
    if (savedDark !== null) {
        setDarkMode(savedDark === 'true');
    } else {
        setDarkMode(prefersDark);
    }
    darkModeToggle.addEventListener('click', () => {
        const currentlyDark = document.body.classList.contains('dark-mode');
        setDarkMode(!currentlyDark);
    });

    // ------------------------------
    // 3. ANIMATED COUNTERS (Intersection Observer)
    // ------------------------------
    const counters = document.querySelectorAll('.counter');
    let animationTriggered = false;
    const startCounters = () => {
        if (animationTriggered) return;
        animationTriggered = true;
        counters.forEach(counter => {
            const target = parseInt(counter.getAttribute('data-target'));
            let current = 0;
            const step = Math.ceil(target / 40);
            const update = () => {
                current += step;
                if (current >= target) {
                    counter.innerText = target;
                    return;
                }
                counter.innerText = current;
                setTimeout(update, 18);
            };
            update();
        });
    };
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                startCounters();
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.4 });
    const counterRow = document.getElementById('counterRow');
    if (counterRow) observer.observe(counterRow);
    if (counterRow && counterRow.getBoundingClientRect().top < window.innerHeight) startCounters();

    // ------------------------------
    // 4. FORM VALIDATION (JavaScript required)
    // ------------------------------
    const form = document.getElementById('contactForm');
    const nameInput = document.getElementById('contactName');
    const emailInput = document.getElementById('contactEmail');
    const msgInput = document.getElementById('contactMessage');
    const nameErr = document.getElementById('nameError');
    const emailErr = document.getElementById('emailError');
    const msgErr = document.getElementById('msgError');
    const feedbackDiv = document.getElementById('formFeedback');

    const validateEmail = (email) => /^[^\s@]+@([^\s@]+\.)+[^\s@]+$/.test(email);

    form.addEventListener('submit', (e) => {
        e.preventDefault();
        let isValid = true;
        nameErr.style.display = 'none';
        emailErr.style.display = 'none';
        msgErr.style.display = 'none';
        nameErr.innerText = '';
        emailErr.innerText = '';
        msgErr.innerText = '';
        feedbackDiv.innerHTML = '';

        const nameVal = nameInput.value.trim();
        if (nameVal === '' || nameVal.length < 2) {
            nameErr.innerText = 'Please enter your full name.';
            nameErr.style.display = 'block';
            isValid = false;
        }
        const emailVal = emailInput.value.trim();
        if (emailVal === '') {
            emailErr.innerText = 'Email address is required.';
            emailErr.style.display = 'block';
            isValid = false;
        } else if (!validateEmail(emailVal)) {
            emailErr.innerText = 'Enter a valid email (e.g., name@domain.com).';
            emailErr.style.display = 'block';
            isValid = false;
        }
        const msgVal = msgInput.value.trim();
        if (msgVal === '') {
            msgErr.innerText = 'Message cannot be empty.';
            msgErr.style.display = 'block';
            isValid = false;
        } else if (msgVal.length < 5) {
            msgErr.innerText = 'Message must be at least 5 characters.';
            msgErr.style.display = 'block';
            isValid = false;
        }

        if (isValid) {
            feedbackDiv.innerHTML = '<div class="alert alert-success"><i class="fas fa-check-circle"></i> Message sent! (demo mode — your portfolio is ready)</div>';
            form.reset();
            setTimeout(() => feedbackDiv.innerHTML = '', 4000);
        } else {
            feedbackDiv.innerHTML = '<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> Please fix the errors above.</div>';
        }
    });
</script>
