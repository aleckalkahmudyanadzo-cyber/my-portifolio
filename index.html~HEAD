            color: var(--text-light);
            transition: background 0.3s, color 0.2s;
        }
        /* Dark mode overrides (Bootstrap + custom) */
        body.dark-mode {
            background: #0a1927;
            color: #eef4ff;
        }
        body.dark-mode .card, 
        body.dark-mode .bg-white,
        body.dark-mode .navbar,
        body.dark-mode .list-group-item,
        body.dark-mode .form-control,
        body.dark-mode .form-select {
            background-color: #1a2a36 !important;
            color: #eef4ff !important;
            border-color: #2d3e4e !important;
        }
        body.dark-mode .navbar {
            background-color: #11212e !important;
        }
        body.dark-mode .btn-outline-secondary {
            color: #ffc857;
            border-color: #ffc857;
        }
        body.dark-mode .text-muted {
            color: #b9c7d9 !important;
        }
        body.dark-mode .border-bottom {
            border-color: #2d3e4e !important;
        }
        /* FIX: headings visibility in dark mode */
        body.dark-mode h2,
        body.dark-mode .section-heading {
            color: #ffefb9 !important;  /* bright light yellow */
        }
        body.dark-mode h2 i,
        body.dark-mode .section-heading i {
            color: var(--accent) !important;
        }
        body.dark-mode .card h5 {
            color: #f5f9ff;
        }
        /* accent color */
        .bg-accent { background-color: var(--accent); }
        .text-accent { color: var(--accent); }
        .btn-accent {
            background-color: var(--accent);
            border: none;
            color: #1e2a3e;
            font-weight: 600;
        }
        .btn-accent:hover {
            background-color: var(--accent-dark);
            color: #1e2a3e;
        }
        .stat-card {
            border-radius: 28px;
            transition: transform 0.2s;
            border: 1px solid var(--border-light);
        }
        body.dark-mode .stat-card {
            border-color: #2d3e4e;
            background-color: #1a2a36 !important;
        }
        .stat-card:hover {
