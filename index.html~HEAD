            background: rgba(22, 29, 54, 0.15);
            padding: 0.3rem 1rem;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 500;
            margin: 0.2rem;
        }
        body.dark-mode .skill-tag {
            background: rgba(255,200,87,0.2);
            color: #ffecb3;
        }
        .social-icon {
            font-size: 2rem;
            margin: 0 0.6rem;
            transition: 0.2s;
            color: var(--text-light);
        }
        body.dark-mode .social-icon {
